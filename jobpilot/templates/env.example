# jobpilot secrets. This file stays on your machine: don't commit it, don't paste it into chats.

# Claude API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram: create a bot by messaging @BotFather, paste its token, then run `jobpilot telegram-id`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The Gmail you send from, and an App Password for it
# (Google Account > Security > 2-Step Verification > App passwords).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: Hunter.io key for verified email addresses (free plan: 25 lookups a month).
HUNTER_API_KEY=

# Only on a network that inspects TLS (a company proxy): a CA bundle that includes its root.
# SSL_CERT_FILE=/path/to/ca-bundle.pem
